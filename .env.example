# Configuration Firebase pour 2A Business
# Obtenez ces valeurs depuis votre console Firebase (Project Settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=votre_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=votre-projet
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Numéro WhatsApp de contact (format international Sénégal sans le +)
NEXT_PUBLIC_WHATSAPP_NUMBER=221770620408
